{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure standalone",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build-standalone"],
      "options": { "cwd": "${workspaceFolder}" },
      "osx": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "PATH": "${env:HOME}/Library/Python/3.9/bin:${env:PATH}" }
        }
      },
      "windows": {
        "type": "process",
        "detail": "Requires vcpkg at C:/vcpkg (curl:x64-windows-static). Uses the Visual Studio generator.",
        "command": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "VCPKG_ROOT": "C:/vcpkg"
          }
        },
        "args": [
          "-S",
          ".",
          "-B",
          "build-standalone",
          "-DCMAKE_TOOLCHAIN_FILE=C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "-DVCPKG_TARGET_TRIPLET=x64-windows-static"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Configure standalone (RelWithDebInfo)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build-standalone",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "osx": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "PATH": "${env:HOME}/Library/Python/3.9/bin:${env:PATH}" }
        }
      },
      "windows": {
        "type": "process",
        "command": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "VCPKG_ROOT": "C:/vcpkg"
          }
        },
        "args": [
          "-S",
          ".",
          "-B",
          "build-standalone",
          "-DCMAKE_TOOLCHAIN_FILE=C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "-DVCPKG_TARGET_TRIPLET=x64-windows-static",
          "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Build standalone",
      "detail": "Debug build (unoptimized; use for breakpoints). On Windows uses --config Debug.",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-standalone",
        "--target",
        "avionics-standalone",
        "-j8"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "osx": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "PATH": "${env:HOME}/Library/Python/3.9/bin:${env:PATH}" }
        }
      },
      "windows": {
        "type": "process",
        "command": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "args": [
          "--build",
          "build-standalone",
          "--target",
          "avionics-standalone",
          "--config",
          "Debug",
          "-j8"
        ],
        "problemMatcher": ["$msCompile"]
      },
      "group": "build",
      "dependsOn": ["Configure standalone"],
      "problemMatcher": []
    },
