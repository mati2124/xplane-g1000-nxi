    {
      "label": "Run PFD (demo)",
      "detail": "Debug build, then launch the PFD window only (demo feed, Debug menu). Slow; use the Release task for normal dev.",
      "type": "shell",
      "command": "${workspaceFolder}/build-standalone/shell-standalone/avionics-standalone",
      "args": ["--no-mfd", "--demo", "--debug-menu"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "AVIONICS_SKIP_UPDATE_CHECK": "1" }
      },
      "windows": {
        "command": "${workspaceFolder}/build-standalone/shell-standalone/Debug/avionics-standalone.exe"
      },
      "dependsOn": ["Build standalone"],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "avionics-demo",
        "clear": true
      },
      "problemMatcher": []
    },
