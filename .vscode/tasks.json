{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure standalone",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build-standalone"],
      "options": { "cwd": "${workspaceFolder}" },
      "osx": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "PATH": "${env:HOME}/Library/Python/3.9/bin:${env:PATH}" }
        }
      },
      "windows": {
        "detail": "Requires VCPKG_ROOT (bootstrap vcpkg, then: vcpkg install curl:x64-windows). Uses the Visual Studio generator.",
        "args": [
          "-S",
          ".",
          "-B",
          "build-standalone",
          "-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Build standalone",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-standalone",
        "--target",
        "avionics-standalone",
        "-j8"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "osx": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "PATH": "${env:HOME}/Library/Python/3.9/bin:${env:PATH}" }
        }
      },
      "windows": {
        "args": [
          "--build",
          "build-standalone",
          "--target",
          "avionics-standalone",
          "--config",
          "Debug",
          "-j8"
        ],
        "problemMatcher": ["$msCompile"]
      },
      "group": "build",
      "dependsOn": ["Configure standalone"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run PFD (demo)",
      "detail": "Build, then launch the PFD window only, booting into the demo feed.",
      "type": "shell",
      "command": "${workspaceFolder}/build-standalone/shell-standalone/avionics-standalone",
      "args": ["--no-mfd", "--demo"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "command": "${workspaceFolder}/build-standalone/shell-standalone/Debug/avionics-standalone.exe"
      },
      "dependsOn": ["Build standalone"],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "avionics-demo",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run MFD (demo)",
      "detail": "Build, then launch the MFD window only, booting into the demo feed.",
      "type": "shell",
      "command": "${workspaceFolder}/build-standalone/shell-standalone/avionics-standalone",
      "args": ["--no-pfd", "--demo"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "command": "${workspaceFolder}/build-standalone/shell-standalone/Debug/avionics-standalone.exe"
      },
      "dependsOn": ["Build standalone"],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "avionics-demo",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run PFD + MFD (demo)",
      "detail": "Build, then launch both display tasks together in demo mode.",
      "dependsOn": ["Run PFD (demo)", "Run MFD (demo)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
