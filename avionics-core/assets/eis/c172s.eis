# G1000 NXi Engine Display — Cessna 172S (Nav III)
# Pilot's Guide Section 3.1. Ship this file (or g1000_eis.txt) beside your .acf.
# Format: TITLE / SECTION / GAUGE / BIND — see avionics-core/include/avionics/Eis.h.

# Tachometer: scale 0-2700 (redline = end of scale). The green normal band and
# the red caution band are contiguous and configurable here; the renderer draws
# them wide enough to cover the white track in those zones.
GAUGE RPM_DIAL
  CHANNEL eng.rpm
  MIN 0 MAX 2700
  REDLINE 2700
  BAND GREEN 2100 2500
  BAND RED 2500 2700

# FFLOW carries a combed scale with "0"/"20" end numerals on the real unit.
GAUGE BAR
  LABEL FFLOW GPH
  CHANNEL eng.fuel_flow
  MIN 0 MAX 20
  TICKS 10
  SCALE
  BAND GREEN 0 11

GAUGE BAR
  LABEL Oil PRES
  CHANNEL eng.oil_pres
  MIN 0 MAX 115
  BAND RED 0 20
  BAND GREEN 50 82
  BAND RED 110 115

GAUGE BAR
  LABEL Oil TEMP
  CHANNEL eng.oil_temp
  MIN 100 MAX 250
  REDLINE 245
  BAND GREEN 110 245
  BAND RED 245 250

# EGT is a combed bar with no band fill or end numerals on the real unit.
GAUGE BAR
  LABEL EGT
  CHANNEL eng.egt
  MIN 1250 MAX 1650
  TICKS 8

GAUGE BAR
  LABEL VAC
  CHANNEL eng.vacuum
  MIN 3 MAX 7
  BAND GREEN 4.5 5.5

# Single shared fuel bar: L pointer above the track, R below (Fig. 3-17). The
# amber caution boundary is an estimate; the Pilot's Guide does not publish the
# exact gallon thresholds.
SECTION
GAUGE FUEL_QTY
  LABEL Fuel QTY GAL
  LEFT L fuel.qty_left
  RIGHT R fuel.qty_right
  MIN 0 MAX 28
  BAND RED 0 1.5
  BAND YELLOW 1.5 5
  BAND GREEN 5 28

SECTION
GAUGE READOUT
  LABEL ENG HRS
  CHANNEL eng.hours
  FORMAT %.1f

SECTION Electrical
GAUGE ELECTRICAL
  LABEL Bus Volts
  LEFT M elec.bus_main
  RIGHT E elec.bus_ess
  FORMAT %.1f

GAUGE ELECTRICAL
  LABEL Battery Amps
  LEFT M elec.batt_main
  RIGHT S elec.batt_standby
  FORMAT %+.0f

# X-Plane dataref bindings (scale/offset convert native units to display units).
BIND eng.rpm sim/cockpit2/engine/indicators/engine_speed_rpm[0] 1 0
BIND eng.fuel_flow sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0] 1323.8784 0
BIND eng.oil_pres sim/cockpit2/engine/indicators/oil_pressure_psi[0] 1 0
BIND eng.oil_temp sim/flightmodel/engine/ENGN_oil_temp_c[0] 1 0
BIND eng.egt sim/flightmodel2/engines/EGT_deg_C[0] 1 0
BIND eng.vacuum sim/cockpit2/gauges/indicators/suction_1_ratio 1 0
BIND fuel.qty_left sim/cockpit2/fuel/fuel_quantity[0] 0.367744 0
BIND fuel.qty_right sim/cockpit2/fuel/fuel_quantity[1] 0.367744 0
BIND eng.hours sim/cockpit2/clock_timer/hobbs_time_hours 1 0
BIND elec.bus_main sim/cockpit2/electrical/bus_volts[0] 1 0
BIND elec.bus_ess sim/cockpit2/electrical/bus_volts[1] 1 0
BIND elec.batt_main sim/cockpit2/electrical/battery_amps[0] 1 0
BIND elec.batt_standby sim/cockpit2/electrical/battery_amps[1] 1 0
