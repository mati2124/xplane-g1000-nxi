# G1000 NXi Engine Display — Piper PA-46T Meridian (Pratt & Whitney PT6A-42A turboprop)
# STYLE TURBOPROP selects the turboprop column renderer.

TITLE ENGINE
STYLE TURBOPROP

GAUGE DIAL
  LABEL TORQUE LB-FT
  CHANNEL eng.torque
  MIN 0 MAX 1500
  REDLINE 1313
  BAND GREEN 0 1313
  BAND RED 1313 1500
  FORMAT %.0f

GAUGE DIAL
  LABEL ITT C
  CHANNEL eng.itt_c
  MIN 0 MAX 1000
  REDLINE 800
  BAND GREEN 400 800
  BAND RED 800 1000
  FORMAT %.0f

GAUGE DIAL
  LABEL PROP RPM
  CHANNEL eng.prop_rpm
  MIN 0 MAX 2200
  REDLINE 2000
  BAND GREEN 1200 2000
  BAND RED 2000 2200
  FORMAT %.0f

GAUGE DIAL
  LABEL NG % RPM
  CHANNEL eng.ng
  MIN 0 MAX 110
  REDLINE 104
  BAND GREEN 60 104
  BAND RED 104 110
  FORMAT %.1f

GAUGE BAR
  LABEL OIL PSI
  CHANNEL eng.oil_pres
  MIN 0 MAX 150
  BAND RED 0 60
  BAND GREEN 80 130
  BAND RED 135 150

GAUGE BAR
  LABEL Oil °C
  CHANNEL eng.oil_temp_c
  MIN -40 MAX 110
  REDLINE 104
  BAND GREEN 0 99
  BAND RED 104 110

SECTION
GAUGE FUEL_QTY_VERT
  LABEL Fuel QTY LBS
  LEFT L fuel.qty_left
  RIGHT R fuel.qty_right
  MIN 0 MAX 600
  BAND RED 0 40
  BAND GREEN 40 600

SECTION
GAUGE READOUT
  LABEL FFLOW PPH
  CHANNEL eng.fuel_flow
  FORMAT %.0f

GAUGE READOUT
  LABEL Fuel TEMP C
  CHANNEL fuel.temp_c
  FORMAT %.0f

# X-Plane dataref bindings (scale/offset convert native units to display units).
BIND eng.torque sim/cockpit2/engine/indicators/torque_ft_lbs[0] 1 0
BIND eng.itt_c sim/cockpit2/engine/indicators/ITT_deg_C[0] 1 0
BIND eng.prop_rpm sim/cockpit2/engine/indicators/prop_speed_rpm[0] 1 0
BIND eng.ng sim/cockpit2/engine/indicators/N1_percent[0] 1 0
BIND eng.oil_pres sim/cockpit2/engine/indicators/oil_pressure_psi[0] 1 0
BIND eng.oil_temp_c sim/cockpit2/engine/indicators/oil_temperature_deg_C[0] 1 0
BIND fuel.qty_left sim/cockpit2/fuel/fuel_quantity[0] 2.20462 0
BIND fuel.qty_right sim/cockpit2/fuel/fuel_quantity[1] 2.20462 0
BIND eng.fuel_flow sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0] 7936.64 0
BIND fuel.temp_c sim/cockpit2/engine/indicators/fuel_temp_deg_C[0] 1 0

BIND cabin.rate_fpm sim/cockpit2/pressurization/indicators/cabin_vvi_fpm 1 0
BIND cabin.alt_ft sim/cockpit2/pressurization/indicators/cabin_altitude_ft 1 0
BIND cabin.diff_psi sim/cockpit2/pressurization/indicators/pressure_differential_psi 1 0
BIND cabin.dest_elev_ft sim/cockpit2/pressurization/actuators/cabin_altitude_ft 1 0
BIND elec.gen1_amps sim/cockpit2/electrical/generator_amps[0] 1 0
BIND elec.gen2_amps sim/cockpit2/electrical/generator_amps[1] 1 0
BIND elec.bus_main sim/cockpit2/electrical/bus_volts[0] 1 0
BIND eng.vacuum sim/cockpit/pressure/vacuum_suction_inHg 1 0
BIND trim.rudder sim/cockpit2/controls/rudder_trim 1 0
BIND flaps.actual sim/cockpit2/controls/flap_handle_deploy_ratio 1 0
BIND gear.nose sim/flightmodel2/gear/deploy_ratio[0] 1 0
BIND gear.left sim/flightmodel2/gear/deploy_ratio[1] 1 0
BIND gear.right sim/flightmodel2/gear/deploy_ratio[2] 1 0
